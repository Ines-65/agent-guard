{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "summary.json",
  "title": "Summary",
  "description": "Analyst-facing incident summary. 'check' is filled by the evidence checker (code), never by the LLM.",
  "type": "object",
  "required": ["session_id", "generated_at", "policy", "profile", "claims"],
  "additionalProperties": false,
  "properties": {
    "session_id":   {"type": "string"},
    "run_id":       {"type": ["string", "null"]},
    "generated_at": {"type": "string", "format": "date-time"},
    "policy":       {"enum": ["agent"]},
    "model_id":     {"type": "string"},
    "profile": {
      "type": "object",
      "required": ["actor", "skill", "objective", "confidence", "evidence"],
      "additionalProperties": false,
      "properties": {
        "actor":      {"enum": ["human", "bot", "ai_agent", "unknown"]},
        "skill":      {"enum": ["low", "mid", "high", "unknown"]},
        "objective":  {"enum": ["data_theft", "credential_theft", "persistence", "recon", "manipulation", "unknown"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "evidence":   {"type": "array", "items": {"pattern": "^evt-[0-9]{6,}$"}}
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["text", "confidence", "evidence"],
        "additionalProperties": false,
        "properties": {
          "text":       {"type": "string", "maxLength": 300},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "evidence":   {"type": "array", "minItems": 1, "items": {"pattern": "^evt-[0-9]{6,}$"}},
          "check":      {"enum": ["verified", "unsupported", "needs_review", "unchecked"], "default": "unchecked"},
          "check_detail": {"type": ["string", "null"]}
        }
      }
    },
    "techniques":  {"type": "array", "items": {"pattern": "^T[0-9]{4}(\\.[0-9]{3})?$"}},
    "owasp_agentic": {"type": "array", "items": {"pattern": "^ASI[0-9]{2}$"}},
    "next_moves":  {"type": "array", "maxItems": 3, "items": {"type": "object", "required": ["technique", "p"], "properties": {"technique": {"type": "string"}, "p": {"type": "number", "minimum": 0, "maximum": 1}}}},
    "injection_detected": {"type": "boolean"},
    "recommended": {"type": "array", "items": {"type": "object", "required": ["tool"], "properties": {"tool": {"type": "string"}, "ioc": {"type": "string"}, "reason": {"type": "string"}}}}
  }
}
