{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "world_model.json",
  "title": "World model",
  "description": "The fake company. Decoys, wiki and agent may only reference hosts, users and URLs listed here. Adapted from Maya's CompanyBlueprint.",
  "type": "object",
  "required": ["company_name", "industry", "employees", "hosts", "internal_urls", "tech_stack"],
  "additionalProperties": false,
  "properties": {
    "company_name": {"type": "string"},
    "industry":     {"type": "string"},
    "product":      {"type": "string"},
    "domain":       {"type": "string", "description": "Internal domain, e.g. corp.example.internal"},
    "tech_stack":   {"type": "array", "items": {"type": "string"}},
    "employees": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "role", "department", "username"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string"}, "role": {"type": "string"},
          "department": {"type": "string"}, "username": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{1,31}$"}
        }
      }
    },
    "hosts": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "ip", "role", "decoy"],
        "additionalProperties": false,
        "properties": {
          "name":     {"type": "string"},
          "ip":       {"type": "string"},
          "role":     {"enum": ["jump", "db", "ftp", "web", "wiki", "api", "canary"]},
          "services": {"type": "array", "items": {"type": "string"}},
          "decoy":    {"type": "boolean"},
          "min_tier": {"type": "integer", "minimum": 1, "maximum": 3, "default": 1}
        }
      }
    },
    "internal_urls": {"type": "array", "items": {"type": "string"}}
  }
}
